{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treningsapp",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-10-01",
  // Built Vue app; only /api/* runs the Worker, everything else is static (SPA fallback).
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "treningsapp",
      "database_id": "467e0538-6023-4ab7-b8e4-cfd2c0e3a1aa",
      "migrations_dir": "server/migrations"
    }
  ],
  "vars": {
    "CAL_KIDS_NAME": "Samvær",
    "CAL_RACES_NAME": "Løp / trening",
    // Access application "Treningsapp" (Zero Trust → Access → Applications). Not secret.
    "ACCESS_TEAM_DOMAIN": "olemartin.cloudflareaccess.com",
    "ACCESS_AUD": "44a2bc5e3d77a83b48c8854966f0aa7ee1695ba54c3628e340b46794aafb649f"
  },
  // Only the Access-protected workers.dev URL; no per-version preview URLs.
  "preview_urls": false,
  // Secrets (wrangler secret put): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, INTERVALS_API_KEY, INTERVALS_ATHLETE_ID
  "observability": { "enabled": true }
}
